# ============================================
# LENZRO SAAS PLATFORM - ENVIRONMENT VARIABLES
# Multi-Industry Business Management Platform
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (remove .example)
# 2. Fill in all the values below
# 3. NEVER commit .env to git!
# ============================================

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ============================================
# PAYPAL CONFIGURATION (REQUIRED FOR PAYMENTS)
# ============================================
# Get these from: https://developer.paypal.com
# Mode: 'sandbox' for testing, 'live' for production
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
VITE_PAYPAL_MODE=sandbox

# PayPal Webhook Secret (for verifying webhook authenticity)
PAYPAL_WEBHOOK_ID=your_webhook_id

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_NAME=Lenzro
VITE_APP_DESCRIPTION=Multi-Industry Business Management Platform
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api

# Default settings for new organizations
VITE_DEFAULT_CURRENCY=KES
VITE_DEFAULT_COUNTRY=KE
VITE_DEFAULT_TIMEZONE=Africa/Nairobi
VITE_DEFAULT_LANGUAGE=en

# App Environment
NODE_ENV=development
VITE_ENV=development

# ============================================
# FIREBASE (REQUIRED FOR PUSH NOTIFICATIONS - Phase 2)
# ============================================
# Get these from: Firebase Console → Project Settings → General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Cloud Messaging Server Key
FIREBASE_SERVER_KEY=your_firebase_server_key

# ============================================
# GOOGLE PLAY (REQUIRED FOR ANDROID IAP - Phase 3)
# ============================================
# Get these from: Google Play Console → API Access
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
GOOGLE_PLAY_PACKAGE_NAME=com.lenzro.app

# Google Play Product IDs (must match Google Play Console)
GOOGLE_PLAY_PRODUCT_BASIC_MONTHLY=basic_monthly
GOOGLE_PLAY_PRODUCT_BASIC_YEARLY=basic_yearly
GOOGLE_PLAY_PRODUCT_PREMIUM_MONTHLY=premium_monthly
GOOGLE_PLAY_PRODUCT_PREMIUM_YEARLY=premium_yearly

# ============================================
# APPLE (REQUIRED FOR iOS IAP - Phase 3)
# ============================================
# Get these from: App Store Connect → My Apps → In-App Purchases
APPLE_SHARED_SECRET=your_apple_shared_secret
APPLE_TEAM_ID=your_apple_team_id
APPLE_BUNDLE_ID=com.lenzro.app

# Apple Product IDs (must match App Store Connect)
APPLE_PRODUCT_BASIC_MONTHLY=com.lenzro.basic.monthly
APPLE_PRODUCT_BASIC_YEARLY=com.lenzro.basic.yearly
APPLE_PRODUCT_PREMIUM_MONTHLY=com.lenzro.premium.monthly
APPLE_PRODUCT_PREMIUM_YEARLY=com.lenzro.premium.yearly

# ============================================
# MOBILE MONEY (OPTIONAL - For Direct Integration)
# ============================================
# M-Pesa (Kenya) - Popular in East Africa
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_ENVIRONMENT=sandbox

# ============================================
# EMAIL SERVICE (OPTIONAL - For Custom Emails)
# ============================================
# Supabase Auth handles basic emails, but you can add:
# SendGrid (recommended)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@lenzro.com
EMAIL_FROM_NAME=Lenzro Team

# AWS SES (alternative)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-access-key
AWS_SES_SECRET_ACCESS_KEY=your-secret-key
AWS_SES_FROM_EMAIL=noreply@lenzro.com

# ============================================
# SMS SERVICE (OPTIONAL - For 2FA and Notifications)
# ============================================
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (Popular in Africa)
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key

# ============================================
# ANALYTICS & MONITORING (OPTIONAL - Phase 6)
# ============================================
# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking - Recommended for production)
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# PostHog (Product Analytics)
VITE_POSTHOG_API_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# STORAGE & CDN (OPTIONAL - Supabase has built-in storage)
# ============================================
# Cloudinary (for advanced image processing)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (alternative to Supabase Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# ============================================
# SECURITY
# ============================================
# JWT Secret (for custom auth if needed)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=your_encryption_key_32_chars

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://lenzro.com

# ============================================
# MOBILE APP CONFIGURATION
# ============================================
# Android Keystore (for release builds)
ANDROID_KEYSTORE_PATH=./android/lenzro.keystore
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=lenzro
ANDROID_KEY_PASSWORD=your-key-password

# iOS Configuration
IOS_BUNDLE_ID=com.lenzro.app
IOS_TEAM_ID=your-team-id

# ============================================
# DATABASE BACKUP (OPTIONAL - Phase 6)
# ============================================
# AWS S3 for backups
AWS_S3_BACKUP_BUCKET=lenzro-backups
AWS_S3_BACKUP_REGION=us-east-1

# Backup Schedule (cron format - daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
VITE_DEV_MODE=true
VITE_ENABLE_LOGGING=true

# Skip email verification in development (DANGEROUS in production!)
VITE_SKIP_EMAIL_VERIFICATION=false

# ============================================
# PRODUCTION SETTINGS (Uncomment for production)
# ============================================
# NODE_ENV=production
# VITE_ENV=production
# VITE_DEV_MODE=false
# VITE_ENABLE_LOGGING=false
# VITE_PAYPAL_MODE=live
# MPESA_ENVIRONMENT=production
# VITE_APP_URL=https://app.lenzro.com
# VITE_API_URL=https://api.lenzro.com

# ============================================
# SUPPORT & HELP
# ============================================
VITE_SUPPORT_EMAIL=support@lenzro.com
VITE_SUPPORT_PHONE=+254-XXX-XXX-XXX
VITE_DOCUMENTATION_URL=https://docs.lenzro.com

# ============================================
# PRIORITY GUIDE
# ============================================
#
# TO GET STARTED (Minimum required):
# 1. VITE_SUPABASE_URL
# 2. VITE_SUPABASE_ANON_KEY
# 3. SUPABASE_SERVICE_ROLE_KEY
#
# FOR PAYMENTS (Phase 3):
# 4. VITE_PAYPAL_CLIENT_ID
# 5. PAYPAL_CLIENT_SECRET
#
# FOR MOBILE PUSH NOTIFICATIONS (Phase 2):
# 6. All VITE_FIREBASE_* variables
#
# FOR MOBILE IN-APP PURCHASES (Phase 3):
# 7. GOOGLE_PLAY_* (Android)
# 8. APPLE_* (iOS)
#
# RECOMMENDED FOR PRODUCTION:
# 9. VITE_SENTRY_DSN (error tracking)
# 10. SENDGRID_API_KEY (custom emails)
# 11. VITE_GA_MEASUREMENT_ID (analytics)
#
# ============================================
